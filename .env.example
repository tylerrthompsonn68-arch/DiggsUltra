# Copy to .env.local for local dev. Never commit real values.
# On Vercel, set these in Project Settings > Environment Variables.

# --- Site ---
NEXT_PUBLIC_SITE_URL=            # e.g. http://localhost:3000 or https://diggsultra.com

# --- Admin ---
ADMIN_EMAIL=                     # Only email allowed into /admin; also receives inquiry alerts

# --- Database (Phase 0) ---
DATABASE_URL=                    # Postgres connection string (Neon via Vercel Marketplace)

# --- Auth.js (Phase 1) ---
AUTH_SECRET=                     # generate with: npx auth secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Email: Resend (Phase 1) ---
RESEND_API_KEY=
EMAIL_FROM=                      # e.g. "Diggs <bookings@diggsultra.com>"

# --- Spam: Cloudflare Turnstile (Phase 1) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Video feed (Phase 2) ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# --- Google Calendar (Phase 3) ---
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_CLIENT_EMAIL=    # service account
GOOGLE_CALENDAR_PRIVATE_KEY=

# --- Cron (Phase 3) ---
CRON_SECRET=
